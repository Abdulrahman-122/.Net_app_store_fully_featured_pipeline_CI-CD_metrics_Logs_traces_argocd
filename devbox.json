{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.10.7/.schema/devbox.schema.json",
  "packages": [
    "act@latest",
    "argocd@latest",
    "awscli2@latest",
    "docker@latest",
    "envsubst@latest",
    "gh@latest",
    "go@latest",
    "go-task@latest",
    "gum@latest",
    "jq@latest",
    "k9s@latest",
    "kind@latest",
    "kluctl@latest",
    "ko@latest",
    "kubectl@latest",
    "kubectx@latest",
    "kubent@latest",
    "kubernetes-helm@latest",
    "kustomize@latest",
    "nodejs_24@latest",
    "oras@latest",
    "poetry@2.3",
    "procps",
    "python312@latest",
    "stern@latest",
    "terraform@latest",
    "tilt@latest",
    "trivy@latest",
    "yq-go@latest"
  ],
  "shell": {
    "init_hook": [
      "export GOBIN=$(git rev-parse --show-toplevel)/bin",
      "export PATH=$GOBIN:$PATH",
      "# Install cloud-provider-kind if not already installed",
      "if [ ! -f \\\"$GOBIN/cloud-provider-kind\\\" ]; then",
      "  go install sigs.k8s.io/cloud-provider-kind@v0.2.0",
      "fi"
    ],
    "scripts": {
      "test": [
        "echo \"No tests configured\""
      ]
    }
  }
}

